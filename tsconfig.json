{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/components/*": ["src/components/*"],
      "@/game/*": ["src/game/*"],
      "@/systems/*": ["src/game/systems/*"],
      "@/scenes/*": ["src/game/scenes/*"],
      "@/objects/*": ["src/game/objects/*"],
      "@/data/*": ["src/game/data/*"],
      "@/styles/*": ["src/styles/*"],
      "@/layouts/*": ["src/layouts/*"],
      "@/pages/*": ["src/pages/*"]
    }
  },
  "include": ["src/**", "tests/**"]
}
