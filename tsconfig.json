{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/components/*": ["src/components/*"],
      "@/game/*": ["src/game/*"],
      "@/systems/*": ["src/game/systems/*"],
      "@/scenes/*": ["src/game/scenes/*"],
      "@/objects/*": ["src/game/objects/*"],
      "@/data/*": ["src/game/data/*"]
    }
  },
  "include": ["src/**/*"]
}
