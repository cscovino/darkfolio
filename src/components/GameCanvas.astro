---
import GameOverlay from './GameOverlay.astro';
---
<div id="game-frame" class="frame">
  <div id="game-root"></div>
  <GameOverlay />
</div>

<script>
  import { createGame } from '@/game/main';
  createGame('game-root');
</script>

<style>
  .frame {
    position: relative;
    overflow: hidden;
    container-type: size;
    box-sizing: border-box;
    width: min(640px, calc(100vw - 40px), calc((100dvh - 40px) * 4 / 3));
    aspect-ratio: 4 / 3;
    height: auto;
    border: 4px solid #4a3729;
  }

  #game-root {
    width: 100%;
    height: 100%;
  }
</style>
